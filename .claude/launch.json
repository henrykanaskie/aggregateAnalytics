{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-api",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": ["dashboard.api.app:app", "--port", "8017", "--reload"],
      "port": 8017
    },
    {
      "name": "dashboard-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard/web", "run", "dev"],
      "port": 5173
    }
  ]
}
